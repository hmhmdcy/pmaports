-		ret = -1;
-		goto err_free_outbufs;
+	if (inbufs_len > sizeof(inbufs)) {
+		uint32_t required = 0;
+		/* Bound allocations before accepting a DSP-supplied length. */
+		if (inbufs_len > 4U * 1024 * 1024) {
+			fprintf(stderr, "Large input exceeds 4 MiB bound\n");
+			ret = -1;
+			goto err_free_outbufs;
+		}
+		large_inbufs = malloc(inbufs_len);
+		if (!large_inbufs) {
+			ret = -1;
+			goto err_free_outbufs;
