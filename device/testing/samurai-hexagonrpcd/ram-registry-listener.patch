+	if (!inbufs[1].s || !inbufs[3].s || !inbufs[4].s
+	 || ((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
 	 || ((const char *) inbufs[3].p)[inbufs[3].s - 1] != 0
 	 || ((const char *) inbufs[4].p)[inbufs[4].s - 1] != 0)
 		return AEE_EBADPARM;
 
-	rw_mode = ((const char *) inbufs[4].p)[0];
-	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
-				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
+	rw_mode = inbufs[4].p;
+	if (*rw_mode == 'w' || *rw_mode == 'a' || strchr(rw_mode, '+')) {
+		fd = hexagonfs_ram_open(ctx->fds, inbufs[3].p, rw_mode);
+		if (fd < 0) {
+			fprintf(stderr, "RAM registry open failed %s: %s\n",
+				(const char *)inbufs[3].p, strerror(-fd));
+			return AEE_EFAILED;
+		}
+		*out = fd;
+		return 0;
 	}
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
@@ -282,6 +310,23 @@
 	first_out->inode = 0;
 	first_out->is_eof = (*first_out->name == '\0');
 
+	return 0;
+}
+
+static uint32_t apps_std_frename(void *data,
+                                const struct fastrpc_io_buffer *inbufs,
+                                struct fastrpc_io_buffer *outbufs)
+{
+	int ret;
+	if (!inbufs[1].s || !inbufs[2].s || !inbufs[1].p || !inbufs[2].p ||
+	    memchr(inbufs[1].p, 0, inbufs[1].s) != (char *)inbufs[1].p + inbufs[1].s - 1 ||
+	    memchr(inbufs[2].p, 0, inbufs[2].s) != (char *)inbufs[2].p + inbufs[2].s - 1)
+		return AEE_EBADPARM;
+	ret = hexagonfs_ram_rename(inbufs[1].p, inbufs[2].p);
+	if (ret) {
+		fprintf(stderr, "RAM registry rename failed: %s\n", strerror(-ret));
+		return AEE_EFAILED;
+	}
 	return 0;
 }
 
