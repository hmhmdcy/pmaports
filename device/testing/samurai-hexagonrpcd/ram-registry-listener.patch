+				ADSP_LISTENER_HANDLE, *rctx, (uint32_t)sizeof(inbufs),
+				&required, inbufs_len - (uint32_t)sizeof(inbufs),
+				large_inbufs + sizeof(inbufs));
+		if (ret || required != inbufs_len) {
+			fprintf(stderr, "Large input retrieval failed: ret=%d required=%u expected=%u\n",
+				ret, required, inbufs_len);
+			ret = -1;
+			goto err_free_outbufs;
+		}
+		input = large_inbufs;
 	}
 
