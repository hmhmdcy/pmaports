Subject: [PATCH] hexagonrpcd: serve bounded sensor registry writes from RAM

Add the OEM metadata mapping, extended method dispatch and bounded large
input retrieval required by the sensor service. Registry writes never reach
persistent storage. Preserve upstream verbosity defaults.

--- a/hexagonrpcd/apps_std.c
+++ b/hexagonrpcd/apps_std.c
@@ -57,11 +57,13 @@
 #ifdef HEXAGONRPC_VERBOSE
 	uint32_t *fd = inbufs[0].p;
 
-	printf("ignore fflush(%u)\n", *fd);
-#endif
-
-	memset(outbufs[0].p, 0, outbufs[0].s);
-
+	printf("fflush(%u)\n", *fd);
+#endif
+
+	struct apps_std_ctx *ctx = data;
+	const uint32_t *fdnum = inbufs[0].p;
+	if (inbufs[0].s < sizeof(*fdnum) || hexagonfs_ram_flush(ctx->fds, *fdnum))
+		return AEE_EFAILED;
 	return 0;
 }
 
@@ -120,6 +122,26 @@
 	return 0;
 }
 
+static uint32_t apps_std_fwrite(void *data,
+                               const struct fastrpc_io_buffer *inbufs,
+                               struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct { uint32_t fd, buf_size; } *in = inbufs[0].p;
+	struct { uint32_t written, is_eof; } *out = outbufs[0].p;
+	ssize_t n;
+	if (inbufs[0].s < sizeof(*in) || outbufs[0].s < sizeof(*out) ||
+	    in->buf_size > inbufs[1].s)
+		return AEE_EBADPARM;
+	n = hexagonfs_ram_write(ctx->fds, in->fd, in->buf_size, inbufs[1].p);
+	if (n < 0) {
+		fprintf(stderr, "RAM registry write failed: %s\n", strerror(-n));
+		return AEE_EFAILED;
+	}
+	out->written = n; out->is_eof = n < in->buf_size;
+	return 0;
+}
+
 static uint32_t apps_std_fseek(void *data,
 			       const struct fastrpc_io_buffer *inbufs,
 			       struct fastrpc_io_buffer *outbufs)
@@ -156,20 +178,26 @@
