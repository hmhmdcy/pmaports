maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=samurai-hexagonrpcd
pkgver=1
pkgrel=0
pkgdesc="Realme X2 Pro hexagonrpcd"
url="https://github.com/hmhmdcy/realme-x2-pro-pmaports"
arch="aarch64"
license="GPL-3.0-or-later"
options="!check !strip"
makedepends="linux-headers"
source="hexagonrpc-v0.4.0.tar.gz::https://codeload.github.com/linux-msm/hexagonrpc/tar.gz/23a69640bf10dc498226c602c5b5db11d8cb3d8e
 ram-registry-listener.patch hexagonfs_ram_registry.c"
builddir="$srcdir/hexagonrpc-23a69640bf10dc498226c602c5b5db11d8cb3d8e"
prepare() {
 default_prepare
 cp "$srcdir"/hexagonfs_ram_registry.c hexagonrpcd/
}
build() {
 $CC $CFLAGS -static -O2 -Wall -Wextra -Wno-unused-parameter -Iinclude \
 libhexagonrpc/context.c libhexagonrpc/fastrpc.c libhexagonrpc/interfaces.c libhexagonrpc/session.c \
 hexagonrpcd/aee_error.c hexagonrpcd/apps_mem.c hexagonrpcd/apps_std.c hexagonrpcd/interfaces.c hexagonrpcd/hexagonfs.c \
 hexagonrpcd/hexagonfs_mapped.c hexagonrpcd/hexagonfs_plat_subtype_name.c hexagonrpcd/hexagonfs_virt_dir.c \
 hexagonrpcd/hexagonfs_ram_registry.c hexagonrpcd/iobuffer.c hexagonrpcd/listener.c hexagonrpcd/localctl.c \
 hexagonrpcd/rpcd.c hexagonrpcd/rpcd_builder.c -pthread $LDFLAGS -o samurai-hexagonrpcd
}
package() {
 install -Dm755 samurai-hexagonrpcd "$pkgdir"/usr/libexec/samurai-hexagonrpcd
 mkdir -p "$pkgdir"/usr/share/samurai
 (cd "$pkgdir" && sha256sum usr/libexec/samurai-hexagonrpcd) > "$pkgdir"/usr/share/samurai/ssc-daemon.sha256
 sed -i 's@  usr/@  /usr/@' "$pkgdir"/usr/share/samurai/ssc-daemon.sha256
}

