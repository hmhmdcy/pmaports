maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=samurai-libssc
pkgver=1
pkgrel=0
pkgdesc="Realme X2 Pro libssc"
url="https://github.com/hmhmdcy/pmaports"
arch="aarch64"
license="GPL-3.0-or-later"
options="!check !strip"
depends="libssc"
makedepends="eudev-dev glib-dev libgudev-dev linux-headers libqmi-dev meson protobuf-c-dev protobuf-dev python3-dev py3-gobject3 py3-protobuf qrtr-libs"
source="https://deb.debian.org/debian/pool/main/libs/libssc/libssc_0.4.4.orig.tar.gz libssc-wise-light.patch"
builddir="$srcdir/libssc"
build() {
 abuild-meson -Db_lto=true . output
 meson compile -C output
}
package() {
 install -Dm755 output/src/libssc.so.2 "$pkgdir"/usr/lib/samurai/ssc/libssc.so.2
 mkdir -p "$pkgdir"/usr/share/samurai
 (cd "$pkgdir" && sha256sum usr/lib/samurai/ssc/libssc.so.2) > "$pkgdir"/usr/share/samurai/ssc-library.sha256
 sed -i 's@  usr/@  /usr/@' "$pkgdir"/usr/share/samurai/ssc-library.sha256
}

