maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=samurai-radio-tools
pkgver=1
pkgrel=0
pkgdesc="Realme X2 Pro radio-tools"
url="https://github.com/hmhmdcy/pmaports"
arch="aarch64"
license="BSD-3-Clause AND MIT"
options="!check"
makedepends="linux-headers"
source="qrtr-29e36ae.tar.gz::https://codeload.github.com/linux-msm/qrtr/tar.gz/29e36ae164389580a0f8ea7a7fdb728140ae978d
 tqftpserv-128cd6e.tar.gz::https://codeload.github.com/linux-msm/tqftpserv/tar.gz/128cd6e0a39734fefd0f0bf0aad5e997c29e2445
 rmtfs-b30a3eb.tar.gz::https://api.github.com/repos/linux-msm/rmtfs/tarball/b30a3eb
 tqftpserv-work-files.patch rmtfs-cow-handler.patch rmtfs-runtime-root.patch
 storage-cow.c sharedmem-bounded.c samurai-tftp-ram.c ro-firmware.c
 dms-mac-read.c samurai-bt-address.c"
builddir="$srcdir"
prepare() {
 patch --fuzz=0 -d tqftpserv-128cd6e0a39734fefd0f0bf0aad5e997c29e2445 -p1 < tqftpserv-work-files.patch
 patch --fuzz=0 -d linux-msm-rmtfs-b30a3eb -p1 < rmtfs-cow-handler.patch
 patch --fuzz=0 -d linux-msm-rmtfs-b30a3eb -p1 < rmtfs-runtime-root.patch
 cp storage-cow.c linux-msm-rmtfs-b30a3eb/storage.c
 cp sharedmem-bounded.c linux-msm-rmtfs-b30a3eb/sharedmem.c
 printf '#include <errno.h>\nint rproc_start(void){return -EPERM;}\nint rproc_stop(void){return -EPERM;}\n' > rproc-disabled.c
}
build() {
 local q=qrtr-29e36ae164389580a0f8ea7a7fdb728140ae978d
 local t=tqftpserv-128cd6e0a39734fefd0f0bf0aad5e997c29e2445
 local r=linux-msm-rmtfs-b30a3eb
 $CC $CFLAGS -D_GNU_SOURCE -O2 -static -I$q/include -I$t $t/tqftpserv.c samurai-tftp-ram.c $q/lib/qrtr.c $q/lib/logging.c ro-firmware.c $LDFLAGS -o samurai-tqftpserv
 $CC $CFLAGS -O2 -static -I$q/include -I$q/lib -I$r $r/rmtfs.c $r/qmi_rmtfs.c rproc-disabled.c $r/storage.c $r/sharedmem.c $q/lib/qrtr.c $q/lib/qmi.c $q/lib/logging.c $LDFLAGS -o samurai-rmtfs-cow
 $CC $CFLAGS -O2 -static -I$q/include dms-mac-read.c $q/lib/qrtr.c $q/lib/logging.c $LDFLAGS -o samurai-dms-mac-read
 $CC $CFLAGS -O2 -static samurai-bt-address.c $LDFLAGS -o samurai-bt-address
}
package() {
 for tool in samurai-tqftpserv samurai-rmtfs-cow samurai-dms-mac-read samurai-bt-address; do
  install -Dm755 "$tool" "$pkgdir"/usr/sbin/"$tool"
 done
}

