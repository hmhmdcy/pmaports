source="samurai-gnss-assist.py samurai-gnss-assist.initd test-power-policy.py NOTICE
	samurai-gnss-assist.post-install samurai-gnss-assist.pre-deinstall"
check() {
	python3 "$srcdir"/test-power-policy.py
}
package() {
	install -Dm755 "$srcdir"/samurai-gnss-assist.py "$pkgdir"/usr/sbin/samurai-gnss-assist
	install -Dm755 "$srcdir"/samurai-gnss-assist.initd "$pkgdir"/etc/init.d/samurai-gnss-assist
	install -Dm644 "$srcdir"/NOTICE "$pkgdir"/usr/share/doc/samurai-gnss-assist/NOTICE
}

