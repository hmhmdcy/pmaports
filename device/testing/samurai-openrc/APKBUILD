package() {
 for name in bluetooth elogind iio-sensor-proxy postmarketos-zram-swap; do
  install -Dm755 "$srcdir"/$name.initd "$pkgdir"/etc/init.d/$name
 done
 for name in bluetooth networkmanager chronyd sshd iio-sensor-proxy; do
  install -Dm644 "$srcdir"/$name.confd "$pkgdir"/etc/conf.d/$name
 done
}

