source="bluetooth.initd elogind.initd iio-sensor-proxy.initd postmarketos-zram-swap.initd
 bluetooth.confd networkmanager.confd chronyd.confd sshd.confd iio-sensor-proxy.confd"
package() {
 for name in bluetooth elogind iio-sensor-proxy postmarketos-zram-swap; do
  install -Dm755 "$srcdir"/$name.initd "$pkgdir"/etc/init.d/$name
 done
 for name in bluetooth iio-sensor-proxy; do
  install -Dm644 "$srcdir"/$name.confd "$pkgdir"/etc/conf.d/$name
 done
 for name in networkmanager chronyd sshd; do
  install -Dm644 "$srcdir"/$name.confd "$pkgdir"/usr/share/samurai/openrc-overrides/$name
 done
}

