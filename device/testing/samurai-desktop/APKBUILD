maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=samurai-desktop
pkgver=1
pkgrel=0
pkgdesc="Realme X2 Pro desktop"
url="https://github.com/hmhmdcy/pmaports"
arch="noarch"
license="LicenseRef-Local-Project"
options="!check"
depends="phosh greetd samurai-openrc snapshot"
source="samurai-phosh-session samurai-phosh.toml greetd.confd org.gnome.Snapshot.desktop org.gnome.Snapshot.service samurai-bluetooth.conf"
package() {
 install -Dm755 "$srcdir"/samurai-phosh-session "$pkgdir"/usr/bin/samurai-phosh-session
 install -Dm644 "$srcdir"/samurai-phosh.toml "$pkgdir"/etc/greetd/samurai-phosh.toml
 install -Dm644 "$srcdir"/greetd.confd "$pkgdir"/usr/share/samurai/greetd.confd
 install -Dm644 "$srcdir"/org.gnome.Snapshot.desktop "$pkgdir"/usr/share/samurai/user-config/applications/org.gnome.Snapshot.desktop
 install -Dm644 "$srcdir"/org.gnome.Snapshot.service "$pkgdir"/usr/share/samurai/user-config/dbus-1/services/org.gnome.Snapshot.service
 install -Dm644 "$srcdir"/samurai-bluetooth.conf "$pkgdir"/etc/bluetooth/samurai.conf
}

